# EspoCRM-Instanz (ohne abschließenden Slash, ohne /api/v1)
# Beispiel: https://crm.example.com
VITE_ESPOCRM_URL=

# --- Auth: genau EINE der beiden Varianten ausfüllen ---

# Variante 1: API-User mit API-Key (Administration > API Users)
# Hinweis: API-User erhalten I18n nur in der Systemsprache (Annahme A2).
ESPOCRM_API_KEY=

# Variante 2: Regulärer Nutzer + Passwort/Token (Espo-Authorization: Basic)
ESPOCRM_USER=
ESPOCRM_TOKEN=

# --- Optional: Konfiguration für scripts/probe.mjs (Phase 0) ---

# Entitäten, für die Layouts (detail + list) und Listen-Requests getestet werden
ESPOCRM_PROBE_ENTITIES=Contact,Account

# Schreibtest A9 (Optimistic Concurrency): NUR Testdatensatz angeben, KEIN Produktivdatensatz!
# Leer lassen => Schreibtest wird übersprungen.
ESPOCRM_TEST_ENTITY=
ESPOCRM_TEST_RECORD_ID=
